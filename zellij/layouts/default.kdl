// Default layout: single top bar (compact-bar), no bottom status bar.
// Overrides zellij's built-in default layout, which appends a 2-line
// status-bar plugin at the bottom. compact-bar folds the tab/window list plus
// a small mode indicator into one line, so we get mode feedback without the
// wasted keybind-hint row.
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:compact-bar"
        }
        children
    }
}
